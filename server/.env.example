# CipherSocial E2EE Engine Server Configuration

# The port the HTTP and WebSocket server will listen on (default: 4000)
PORT=4000

# Environment mode (production / development)
NODE_ENV=production

# Directory for storing encrypted zk_database.json (set to /var/data if using a cloud volume)
# DATA_DIR=/var/data

# Allowed CORS Origins (comma-separated, leave blank to allow all origins)
# CORS_ORIGIN=https://ciphersocial.vercel.app,https://your-domain.com
